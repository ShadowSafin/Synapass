# Dashboard environment.
#
# These are read by the Next.js *server*, never inlined into the browser bundle,
# which is the whole point: the gateway's administrative API requires an admin
# key and the browser must never hold one. The dashboard proxies every admin call
# through a route handler that attaches the credential server-side.

# The gateway as seen from the dashboard server. Inside docker compose this is
# the service name; for `npm run dev` on the host it is localhost.
SYNAPASS_API_URL=http://localhost:8080

# The administrative credential used by the proxy. Generate one with
# `openssl rand -hex 24` and set the same value the gateway reads from
# SYNAPASS_ADMIN_KEY. Without it, every page renders a "not authorized" state
# rather than failing.
SYNAPASS_ADMIN_KEY=

# Optional: the browser-visible gateway address, only needed if a panel links
# directly to the gateway (for example to the /metrics endpoint).
# NEXT_PUBLIC_SYNAPASS_API_URL=http://localhost:8080

# Autonomous Benchmark Engine (disabled by default, mirroring the gateway's
# ENABLE_BENCHMARK_ENGINE switch). Set to "true" to show the Benchmark page
# in the sidebar. The gateway still gates every benchmark API route itself.
# NEXT_PUBLIC_ENABLE_BENCHMARK_ENGINE=false
