# Synapass native environment.
#
# Sourced by `synapass native up` and `synapass native install` before
# anything else runs. Anything exported in the real environment wins over a
# line here: the file holds installation defaults, the shell holds decisions.
#
# Copy to native.env (or NATIVE_ROOT/native.env) and edit. Mode 0600: this file
# holds secrets.

# Bootstrap administrator credential for the gateway admin API. Required in
# production: validation refuses to start without it. `native install`
# generates one here on first run; rotate it with:
#   openssl rand -hex 24
SYNAPASS_ADMIN_KEY=

# Point at a checked-in config file, or leave empty to use
# NATIVE_ROOT/config.yaml (written by `native install`).
# SYNAPASS_CONFIG_FILE=/etc/synapass/config.yaml

# --- installation layout (all optional; NATIVE_ROOT redirects everything) ---
# NATIVE_ROOT=/opt/synapass-native
# NATIVE_GATEWAY_BIN=/usr/local/bin/synapass
# NATIVE_DASHBOARD_DIR=/opt/synapass/dashboard
# NATIVE_WORKER_VENV=/opt/synapass/venv

# --- dashboard (read by `native up` when it launches the dashboard) ---
# Where the dashboard reaches the gateway. Default: the local gateway listener.
# SYNAPASS_API_URL=http://127.0.0.1:8080
# Dashboard listen port (PORT wins over --dashboard-port) and bind address.
# The default binds all interfaces: http://localhost:3000 here and
# http://<lan-ip>:3000 from other devices on the same network. Set
# HOSTNAME=127.0.0.1 (or --dashboard-host 127.0.0.1) for loopback-only.
# PORT=3000
# HOSTNAME=0.0.0.0
# The dashboard proxies the admin API server-side with the key set above: no
# second secret to keep in sync, because both processes read this same file.

# --- provider credentials (see documentation/providers.md) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- datastores (only needed when they differ from config.yaml) ---
# SYNAPASS_POSTGRES_HOST=127.0.0.1
# SYNAPASS_POSTGRES_PORT=5432
# SYNAPASS_POSTGRES_USER=synapass
# SYNAPASS_POSTGRES_PASSWORD=
# SYNAPASS_POSTGRES_DB=synapass
# SYNAPASS_REDIS_ADDR=127.0.0.1:6379
# SYNAPASS_NATS_URL=nats://127.0.0.1:4222
