# Synapass environment file for docker compose.
#
# Copy to `.env` and adjust. Compose reads `.env` automatically; every value here
# has a working default in docker-compose.yml, so an unmodified copy boots.
#
# `.env` is git-ignored. Nothing in this file is a real credential: the defaults
# are placeholders that the production validation refuses to accept, which is the
# point -- a deployment has to make a deliberate choice.

# ---------------------------------------------------------------------------
# Deployment identity
# ---------------------------------------------------------------------------
# development | staging | production. `production` tightens gateway validation
# and is what a real install should use.
SYNAPASS_ENVIRONMENT=production

# Host interfaces the published ports bind to.
# The gateway stays loopback-only by default: it serves unauthenticated
# inference, so exposing it to the network is an explicit decision.
# The dashboard requires a console login, so it listens on the LAN by default:
# http://localhost:3000 here, http://<lan-ip>:3000 from phones and other
# devices on the same network. Set DASHBOARD_BIND=127.0.0.1 for loopback-only.
GATEWAY_BIND=127.0.0.1
DASHBOARD_BIND=0.0.0.0

# LAN access for the gateway (other devices calling the API directly).
# The dashboard itself needs nothing extra: it proxies the admin API
# server-side. To let LAN devices call the gateway too (e.g. the curl examples
# on the Endpoints page), bind the gateway to the network AND allow the LAN
# dashboard origin through CORS:
#   GATEWAY_BIND=0.0.0.0
#   SYNAPASS_HTTP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://192.168.1.20:3000
# Use only behind a firewall; the inference surface is unauthenticated.

# Host port for the gateway (container port stays 8080, so gateway config and
# docs do not change). Override when something already occupies 8080 on the
# host, e.g. GATEWAY_PORT=18080. The dashboard's browser bundle and CORS origin
# below must then use the same host port.
GATEWAY_PORT=8080

# The bootstrap administrator credential. Required: a fresh production install
# cannot be administered without it, and the gateway refuses to start.
# Generate one with:  openssl rand -hex 24
SYNAPASS_ADMIN_KEY=syn_admin_change_me_in_production_000000
# Throwaway local evaluation only: SYNAPASS_ALLOW_PLACEHOLDER_ADMIN_KEY=true
# lets the deploy scripts proceed with the placeholder above (with a loud
# warning). Never set this on anything reachable from a network.

# The browser-visible gateway address. Baked into the dashboard bundle at build
# time, so it must be reachable from the user's browser, not from the container.
# Keep the port in sync with GATEWAY_PORT above.
NEXT_PUBLIC_SYNAPASS_API_URL=http://localhost:8080

# LAN address of the gateway shown on the Endpoints page so other devices on
# your network get a working URL, e.g. GATEWAY_LAN_URL=http://192.168.1.20:8080.
# Requires the gateway to bind your network (GATEWAY_BIND=0.0.0.0), which also
# exposes the unauthenticated inference surface: use only behind a firewall.
# Leave empty to hide the LAN block.
# GATEWAY_LAN_URL=

# Browser-allowed dashboard origin for the gateway (CORS). Must match where the
# dashboard is served from; a wildcard is refused in production.
SYNAPASS_HTTP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# PostgreSQL -- the system of record
# ---------------------------------------------------------------------------
POSTGRES_USER=synapass
POSTGRES_PASSWORD=synapass
POSTGRES_DB=synapass

# ---------------------------------------------------------------------------
# ClickHouse -- analytics and traces
# ---------------------------------------------------------------------------
CLICKHOUSE_DB=synapass
CLICKHOUSE_USER=synapass
CLICKHOUSE_PASSWORD=synapass

# ---------------------------------------------------------------------------
# Provider credentials
# ---------------------------------------------------------------------------
# Left empty by default. A provider configured without a reachable credential
# fails to construct, is reported on the admin provider endpoint, and is excluded
# from routing rather than preventing startup.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional explicit data key for provider credentials stored through the admin
# API: a raw 32-byte value, hex or base64. When unset the key derives from the
# admin key, so stock deployments need no new configuration. Rotating the admin
# key then orphans stored secrets, so set this in any deployment that stores
# credentials and may rotate its admin key.
# Generate one with:  openssl rand -hex 32
# SYNAPASS_CREDENTIALS_KEY=

# ---------------------------------------------------------------------------
# Intelligence workers
# ---------------------------------------------------------------------------
# Optional local OpenAI-compatible judge for rubric-based evaluation. Empty
# disables judging; the deterministic scorers remain the only signal.
SYNAPASS_WORKER_PROVIDER_URL=
SYNAPASS_WORKER_PROVIDER_MODEL=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
GRAFANA_USER=admin
# Change this before exposing port 3001 to anything.
GRAFANA_PASSWORD=admin

# ---------------------------------------------------------------------------
# Build provenance
# ---------------------------------------------------------------------------
# Stamped into the binary's version report and the synapass_build_info metric.
SYNAPASS_VERSION=dev
SYNAPASS_COMMIT=unknown
SYNAPASS_BUILD_DATE=unknown

# ---------------------------------------------------------------------------
# Console operator login (optional overrides)
#
# The dashboard creates its own administrator on first launch. These are the
# escape hatches for a non-default policy; the defaults are already safe.
#
# Force the Secure attribute on the session cookie. Normally the gateway decides
# from the request, so a plain-HTTP local install works without it.
# SYNAPASS_ADMIN_DASHBOARD_COOKIE_SECURE=true
# SYNAPASS_ADMIN_DASHBOARD_SESSION_TTL=12h
# SYNAPASS_ADMIN_DASHBOARD_IDLE_TTL=2h
# SYNAPASS_ADMIN_DASHBOARD_MAX_FAILED_ATTEMPTS=5
# SYNAPASS_ADMIN_DASHBOARD_LOCKOUT_DURATION=30s
# SYNAPASS_ADMIN_DASHBOARD_MAX_LOCKOUT_DURATION=15m
# A minimum password length below 12 is raised to 12 rather than applied.
# SYNAPASS_ADMIN_DASHBOARD_MIN_PASSWORD_LENGTH=12

# ---------------------------------------------------------------------------
# Remote access (temporary public tunnels)
# ---------------------------------------------------------------------------
# Allow creating a disposable Cloudflare URL for remote access (the /tunnels
# page or POST /admin/v1/tunnels/create). On by default in Docker because the
# gateway image ships cloudflared; on still exposes nothing until a tunnel is
# actually created. Set false to remove the capability entirely.
# Native installs need cloudflared on PATH. Every request through a tunnel
# still passes Synapass auth, policy and rate limits.
# docker-compose.yml reads these as ${SYNAPASS_TUNNEL_ENABLED:-true} and
# ${SYNAPASS_TUNNEL_DASHBOARD_TARGET:-http://dashboard:3000} -- keep the SYNAPASS_ prefix.
SYNAPASS_TUNNEL_ENABLED=true
# Where the "dashboard" target points. Compose service name, because inside
# Docker the UI is not on the gateway's own loopback interface.
SYNAPASS_TUNNEL_DASHBOARD_TARGET=http://dashboard:3000

# ---------------------------------------------------------------------------
# Autonomous Benchmark Engine (disabled by default)
# ---------------------------------------------------------------------------
# The enterprise benchmarking module. Off means: no Benchmark page, no
# scheduler, no workers, no benchmark API routes, and zero impact on the
# inference gateway. Set true to opt in.
ENABLE_BENCHMARK_ENGINE=false
# SYNAPASS_BENCHMARK_WORKERS=2
# SYNAPASS_BENCHMARK_SCHEDULER_ENABLED=true
# SYNAPASS_BENCHMARK_DEFAULT_TIMEOUT=60s
# SYNAPASS_BENCHMARK_DEFAULT_CONCURRENCY=5
# SYNAPASS_BENCHMARK_MAX_DAILY_COST_USD=0
# NEXT_PUBLIC_ENABLE_BENCHMARK_ENGINE=false
