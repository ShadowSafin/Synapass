# Synapass dashboard -- native systemd unit.
#
# The dashboard is a Next.js standalone server: `npm ci && npm run build` in the
# dashboard checkout produces .next/standalone/server.js, which is all this unit
# runs. It holds no secrets itself; the admin key below is only proxied
# server-side to the gateway, never exposed to the browser.
#
# Install (paths match install/native defaults):
#
#   sudo install -d -m 0750 -o synapass -g synapass /opt/synapass
#   sudo cp -r dashboard /opt/synapass/dashboard
#   sudo chown -R synapass:synapass /opt/synapass/dashboard
#   sudo -u synapass bash -c 'cd /opt/synapass/dashboard && npm ci --no-audit --no-fund && npm run build'
#   sudo install -m 0644 deploy/systemd/synapass-dashboard.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now synapass-dashboard
#
# Configuration lives in /etc/synapass/native.env (mode 0600), written by
# `synapass native install`. Only three variables matter here:
#
#   SYNAPASS_API_URL    gateway as seen from this server, e.g. http://127.0.0.1:8080
#   SYNAPASS_ADMIN_KEY  admin credential, read from the same file as the gateway
#   PORT                listen port (3000)
#
# Put a reverse proxy in front and terminate TLS there; this unit binds
# loopback by default (HOSTNAME below). For LAN access without a proxy, set
# HOSTNAME=0.0.0.0 in /etc/synapass/native.env (the dashboard requires a
# console login, so the LAN surface is authenticated) and allow port 3000
# through the host firewall.

[Unit]
Description=Synapass control-plane dashboard
Documentation=https://github.com/shadowsafin/synapass
After=network-online.target synapass.service
Wants=network-online.target
# The dashboard is useless without the gateway, but a gateway restart must not
# take the dashboard down with it: it reconnects on the next request.

[Service]
Type=simple
User=synapass
Group=synapass
WorkingDirectory=/opt/synapass/dashboard

EnvironmentFile=-/etc/synapass/native.env
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
Environment=NODE_ENV=production

ExecStart=/usr/bin/node .next/standalone/server.js

# Node exits fast on SIGTERM; the timeout only covers in-flight page loads.
KillSignal=SIGTERM
TimeoutStopSec=30s

Restart=on-failure
RestartSec=3s
StartLimitIntervalSec=60s
StartLimitBurst=5

# Same sandbox posture as the gateway unit. Node needs no writable paths: the
# standalone server serves from its own directory read-only.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native

LimitNOFILE=16384

StandardOutput=journal
StandardError=journal
SyslogIdentifier=synapass-dashboard

[Install]
WantedBy=multi-user.target
