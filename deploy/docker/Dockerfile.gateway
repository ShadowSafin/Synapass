# Synapass control plane.
#
# The whole Go module is one binary: the gateway, its background loops, the
# migration command and the health probe. That is what keeps the containerised and
# native deployment paths from drifting apart -- a native install copies this same
# binary and runs this same `synapass` command.

# ---------------------------------------------------------------------------
# Build stage.
# ---------------------------------------------------------------------------
# The base image is pinned to the Go release go.mod requires. A mismatch here is
# not cosmetic: a newer toolchain silently changes language semantics, and GOTOOLCHAIN
# is fixed to local so a build cannot quietly download a different compiler than
# the one CI validated.
#
# Multi-arch: the builder runs natively (BUILDPLATFORM) and cross-compiles to
# TARGETARCH, so `docker buildx build --platform linux/arm64` (e.g. for an
# ARM64 VPS: Graviton, Ampere, Oracle ARM) produces a working binary from an
# amd64 laptop and vice versa. A plain `docker compose up --build` on the VPS
# itself also works: BuildKit sets TARGETARCH to the host arch automatically.
FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS builder
ARG TARGETARCH

ENV GOTOOLCHAIN=local \
    CGO_ENABLED=0 \
    GOOS=linux

WORKDIR /src

# Module files first so the dependency layer is cached across source changes.
COPY go.mod go.sum ./
RUN go mod download

COPY cmd ./cmd
COPY internal ./internal

# Build identity is stamped into the binary rather than read from the environment
# at run time: a version that depends on how a process was started is a version
# nobody can trust in a bug report.
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown
ARG DIRTY=""

# GOARCH comes from TARGETARCH (amd64/arm64 under BuildKit). When TARGETARCH is
# empty (plain `docker build` without buildx) GOARCH is left unset so the Go
# toolchain falls back to the builder's native arch, which is the correct
# behaviour for a native `docker compose up --build` on either amd64 or arm64.
RUN if [ -n "${TARGETARCH:-}" ]; then export GOARCH="${TARGETARCH}"; fi; \
      go build \
      -trimpath \
      -ldflags "-s -w \
        -X github.com/shadowsafin/synapass/internal/version.Version=${VERSION} \
        -X github.com/shadowsafin/synapass/internal/version.Commit=${COMMIT} \
        -X github.com/shadowsafin/synapass/internal/version.BuildDate=${BUILD_DATE} \
        -X github.com/shadowsafin/synapass/internal/version.Dirty=${DIRTY}" \
      -o /out/synapass ./cmd/synapass

# Vet runs in the build stage so an obvious mistake fails the image build rather
# than reaching a runtime.
RUN go vet ./...

# ---------------------------------------------------------------------------
# Runtime stage.
# ---------------------------------------------------------------------------
FROM alpine:3.20 AS runtime

# ca-certificates is required to reach TLS providers; tzdata is required because
# budgets and retention windows are computed in calendar time, and a container
# without zone data silently falls back to UTC.
RUN apk add --no-cache ca-certificates tzdata \
 && addgroup -g 10001 -S synapass \
 && adduser -u 10001 -S -G synapass -h /var/lib/synapass synapass \
 && mkdir -p /etc/synapass /var/lib/synapass \
 && chown -R synapass:synapass /etc/synapass /var/lib/synapass

# cloudflared powers the opt-in temporary tunnels (tunnel.enabled). The version
# is pinned so image rebuilds are reproducible; bump the ARG deliberately, not
# by floating on latest. The binary is owned by root and executable but not
# writable, like the gateway binary itself.
#
# Multi-arch: cloudflared ships per-arch binaries (cloudflared-linux-amd64 /
# cloudflared-linux-arm64). The old hardcoded amd64 URL broke every ARM64 host
# with an exec-format error, so the arch is resolved from TARGETARCH.
ARG CLOUDFLARED_VERSION=2026.9.3
ARG TARGETARCH
RUN set -eux; \
  case "${TARGETARCH:-amd64}" in \
    amd64) CLOUDFLARED_ARCH="amd64" ;; \
    arm64) CLOUDFLARED_ARCH="arm64" ;; \
    *) echo "unsupported TARGETARCH=${TARGETARCH} (want amd64 or arm64)" >&2; exit 1 ;; \
  esac; \
  wget -q -O /usr/local/bin/cloudflared \
    "https://github.com/cloudflare/cloudflared/releases/download/${CLOUDFLARED_VERSION}/cloudflared-linux-${CLOUDFLARED_ARCH}"; \
  chmod 0555 /usr/local/bin/cloudflared; \
  /usr/local/bin/cloudflared --version

# The example config is shipped as the image's starting point. It is named
# config.yaml because that is one of the loader's default search paths
# (`/etc/synapass/config.yaml`), so the image has a valid configuration even if
# SYNAPASS_CONFIG_FILE is never set.
COPY --from=builder /out/synapass /usr/local/bin/synapass
COPY config.example.yaml /etc/synapass/config.yaml

# The executable is owned by root and world-readable but not writable, so a
# compromised process cannot replace its own binary.
RUN chmod 0555 /usr/local/bin/synapass

USER synapass:synapass
WORKDIR /var/lib/synapass

# Sensible container defaults. Every one of these is overridable, and the config
# file is optional because environment variables alone are a valid configuration.
ENV SYNAPASS_ENVIRONMENT=production \
    SYNAPASS_HTTP_ADDR=":8080" \
    SYNAPASS_LOG_FORMAT=json \
    SYNAPASS_CONFIG_FILE=/etc/synapass/config.yaml

EXPOSE 8080

# The healthcheck runs the binary's own probe rather than curling, so the image
# needs no HTTP client and the container check exercises the same code path as the
# systemd unit.
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=4 \
  CMD ["synapass", "health", "http://127.0.0.1:8080/health"]

# exec form so SIGTERM reaches the binary directly; the shell form would make the
# shell PID 1 and swallow the signal, turning every deploy into a hard kill.
ENTRYPOINT ["/usr/local/bin/synapass"]
CMD ["serve"]
